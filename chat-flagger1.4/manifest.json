{
  "manifest_version": 3,
  "name": "Chat Flagger",
  "version": "1.4",
  "description": "סמן הודעות חשובות בשיחות כדי לחזור אליהן בקלות",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
